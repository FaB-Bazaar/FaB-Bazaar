# =============================================================================
# FaB Bazaar — Environment Variables
# Copy this file to .env.local for local development
# On the VPS, copy to .env (docker-compose reads .env by default)
# NEVER commit .env or .env.local — they are git-ignored
# =============================================================================

# -----------------------------------------------------------------------------
# Database — PostgreSQL
# -----------------------------------------------------------------------------
# Full connection string used by the Next.js app
# docker-compose overrides this to use the fabbazaar_app restricted user
POSTGRES_URL=postgresql://fabbazaar_app:your-postgres-password@localhost:5432/fabbazaar

# Docker Compose — used to initialise the postgres container
POSTGRES_USER=fabbazaar
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=fabbazaar

# -----------------------------------------------------------------------------
# Database — Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_PASSWORD=your-redis-password

# -----------------------------------------------------------------------------
# Authentication — NextAuth.js
# Generate with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# AUTH_URL is used by NextAuth v5 internals — set to same value as NEXTAUTH_URL
AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication — Discord OAuth
# From: https://discord.com/developers/applications → OAuth2
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_PUBLIC_KEY=your-discord-public-key
DISCORD_BOT_TOKEN=your-discord-bot-token
# Set to "true" to validate bot tokens against the Discord API on each request
DISCORD_VALIDATE_TOKEN_WITH_API=false

# -----------------------------------------------------------------------------
# Security
# Generate each with: openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=generate-with-openssl-rand-base64-32
ADDRESS_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
CRON_SECRET=generate-with-openssl-rand-base64-32
REVALIDATE_SECRET_TOKEN=generate-with-openssl-rand-base64-32

# -----------------------------------------------------------------------------
# Public — exposed to the browser (NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_HASH_SALT=your-hash-salt
# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Discord — Webhooks (optional)
# Used for trade/binder update notifications posted to Discord channels
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
DISCORD_WEBHOOK_BINDER_UPDATES=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
DISCORD_WEBHOOK_WANTS_UPDATES=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
DISCORD_WEBHOOK_MYSERVER_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# -----------------------------------------------------------------------------
# Cloudflare R2 — Database Backups
# Used by scripts/backup.sh — not required for the app itself
# From: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Permissions needed: Object Read & Write on your backup bucket
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fabbazaar-backups

# -----------------------------------------------------------------------------
# Talishar Integration (optional)
# -----------------------------------------------------------------------------
TALISHAR_API_KEY=your-talishar-api-key
TALISHAR_DEV_API_KEY=your-talishar-dev-api-key
TALISHAR_STAGING_API_KEY=your-talishar-staging-api-key

# -----------------------------------------------------------------------------
# Docker Compose / Deployment
# -----------------------------------------------------------------------------
# Tag applied to the built Next.js image (e.g. 1.0.0, latest)
APP_VERSION=latest
# Internal URL for MCP tool → API calls inside the container (don't change)
MCP_API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
DATABASE_PROVIDER=postgres
ENABLE_FORUMS=false
