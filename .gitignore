# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# macOS
.DS_Store
**/.DS_Store

# backup files
*.bak

# Python bytecode (pipeline scripts)
**/__pycache__/
*.pyc

# Playwright
e2e/
/test-results/
/playwright-report/
playwright.config.ts

# local-only docs (not for public repo)
DEPLOYMENT.md
claude_auth.md
oauth-testing.md
scripts/db-permissions.sql

# uncompressed seed dumps (commit the .gz, not the raw SQL)
seeds/*.sql

# manual test scripts (local dev only, not for CI)
**/*.manual-test.ts

# local-only Docker Compose overrides (port mappings, dev-only services)
docker-compose.override.yml

# explicitly allow .env.example (needed for Docker build)
!.env.example

# dependencies
/node_modules
node_modules/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Ignore local and base environment files that contain secrets.
.env*
.env.local
.env.production
.env.test
.env
.env.development.local
.env.production.local

# NOTE: .env.example and .env.test are intentionally NOT ignored.
# They are necessary for team collaboration and Vercel builds.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cursor IDE
.cursor/
.cursorrules
.cursorrules.json

# Claude Code
.claude/

# Backup logs
logs/

# TLS certificates (private keys must never be committed)
certs/

# Google service-account keys — never commit these
*service-account*.json
ga-sa*.json

# Pipeline — generated data files (runtime artifacts, not source)
pipeline/scripts/cards.enhanced.json
pipeline/scripts/cards.enhanced.report.json
pipeline/scripts/cards.enhanced.summary.txt
pipeline/scripts/cards_with_prices.json
pipeline/scripts/cards_with_prices.price_report.json
pipeline/scripts/cards_with_prices.price_summary.txt
pipeline/scripts/printings_collection_seed.json
pipeline/scripts/price_snapshot.json
pipeline/scripts/market_analysis_export.json
pipeline/scripts/price_history/
pipeline/scripts/logs/post-tournament-decklists.zip

# Local scratch notes (draft article content, throwaway scratchpads)
notes/
