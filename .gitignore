# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# macOS
.DS_Store
**/.DS_Store

# backup files
*.bak

# local-only docs (not for public repo)
DEPLOYMENT.md
claude_auth.md
oauth-testing.md
scripts/db-permissions.sql

# explicitly allow .env.example (needed for Docker build)
!.env.example

# dependencies
/node_modules
node_modules/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Ignore local and base environment files that contain secrets.
.env*
.env.local
.env.production
.env.test
.env
.env.development.local
.env.production.local

# NOTE: .env.example and .env.test are intentionally NOT ignored.
# They are necessary for team collaboration and Vercel builds.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cursor IDE
.cursor/
.cursorrules
.cursorrules.json

# Claude Code
.claude/

# Backup logs
logs/

# TLS certificates (private keys must never be committed)
certs/