fabbazaar.app {
	tls /certs/fabbazaar.app.pem /certs/fabbazaar.app.key

	# Access log — every request, including the ones that succeed. Added after
	# the 2026-08-26 hang: Caddy only logged the requests that 502'd, so the
	# request that wedged the app was invisible. Lives in the caddy_data
	# volume: `docker compose exec caddy tail -f /data/access.log`.
	# Caddy redacts Authorization/Cookie header values by default.
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}

	reverse_proxy nextjs:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Webcam play companion — separate container, separate deploy cadence.
# NOTE: reuses the Cloudflare origin cert; verify it covers *.fabbazaar.app
# (CF origin certs usually do) before pointing DNS at this vhost.
play.fabbazaar.app {
	tls /certs/fabbazaar.app.pem /certs/fabbazaar.app.key

	reverse_proxy fab-table:8787

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
